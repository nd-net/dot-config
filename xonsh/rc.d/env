#!/usr/bin/env xonsh

# XDG base configuration
# The $XDG_ configurations are repeated in mise's config.toml as well
# and mise-tool specific configurations are *only* set by mise

$XDG_CONFIG_HOME = p"$HOME/.config"
$XDG_CACHE_HOME = p"$HOME/.cache"
$XDG_DATA_HOME = p"$HOME/.local/share"
$XDG_STATE_HOME = p"$HOME/.local/state"
$XDG_BIN_HOME = p"$HOME/.local/bin"
# Used for non-essential, user-specific data files such as sockets, named pipes, etc.
# Not required to have a default value; warnings should be issued if not set or equivalents provided.
$XDG_RUNTIME_DIR = p""

### XDG tool configuration ###

# XDG configurations for applications that by default don't honor XDG 
# https://wiki.archlinux.org/title/XDG_Base_Directory

# The VIRTUALENV_HOME is being used by the various vox implementations
# and must be a string instead of a Path
$IPYTHONDIR = str(p"$XDG_CONFIG_HOME/ipython")
$VIRTUALENV_HOME = str(p"$XDG_DATA_HOME/virtualenvs")

# GnuPG
$GNUPGHOME = p"$XDG_DATA_HOME/gnupg"

$LESSHISTFILE = p"$XDG_STATE_HOME/less/history"
$PYTHONHISTFILE = p"$XDG_STATE_HOME/python/history"

### /XDG tool configurations ###

# Other configurations

$HOMEBREW_NO_ENV_HINTS = True
$HOMEBREW_BUNDLE_DESCRIBE = True
$HOMEBREW_NO_ASK = True

source-zsh $(/usr/libexec/path_helper -s)
source-zsh $(/opt/homebrew/bin/brew shellenv)

# Path variables

$d = p"$HOME/Developer"
$icloud = p"$HOME/Library/Mobile Documents"
$PATH.append(p"$d/shell-scripts/bin")
$PATH.append($XDG_BIN_HOME)
